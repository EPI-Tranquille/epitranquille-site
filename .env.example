# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real keys.

# PostHog project API key (Project Settings > Project API Key in PostHog).
# This key is meant to be public/embedded client-side, like a GA measurement
# ID — it is not a secret. Leaving it unset simply disables analytics.
NEXT_PUBLIC_POSTHOG_KEY=

# Match the cloud region your PostHog project lives in:
#   US cloud:  https://us.i.posthog.com  (default if left unset)
#   EU cloud:  https://eu.i.posthog.com
#   Self-hosted: your own instance URL
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
